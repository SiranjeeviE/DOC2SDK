{
    "buildCommand": "cd frontend && npm install && npm run build",
    "outputDirectory": "frontend/dist",
    "framework": "vite",
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "https://doc2sdk-backend.onrender.com/api/$1"
        },
        {
            "source": "/(.*)",
            "destination": "/$1"
        }
    ]
}